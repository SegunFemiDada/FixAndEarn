generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMeta {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_meta")
}

model User {
  id                         String                 @id @default(uuid())
  email                      String                 @unique
  fullName                   String
  passwordHash               String
  isActive                   Boolean                @default(true)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  adminNotes                 String?
  forceReverify              Boolean                @default(false)
  fixerAvailabilityUpdatedAt DateTime?
  fixerPreferredAvailability AvailabilityStatus     @default(UNAVAILABLE)
  averageRating              Float                  @default(0)
  totalRatings               Int                    @default(0)
  emailVerifiedAt            DateTime?
  emailVerifyTokenExpiresAt  DateTime?
  emailVerifyTokenHash       String?
  withdrawalPinHash          String?
  deletionRequestReason      String?
  deletionRequestStatus      DeletionRequestStatus  @default(NONE)
  deletionRequestedAt        DateTime?
  phone                      String?                @unique
  phoneVerifiedAt            DateTime?
  phoneVerifyCode            String?
  phoneVerifyCodeExpiresAt   DateTime?
  sessionVersion             Int                    @default(1)
  deposits                   Deposit[]
  FixerEarnings              FixerEarning[]
  reports                    Report[]
  bankDetails                BankDetails?
  chatAgreements             ChatAgreement[]
  chatMessagesSent           ChatMessage[]          @relation("ChatMessageSender")
  conversationsAsFixer       Conversation[]         @relation("ConversationFixer")
  disputesOpened             Dispute[]              @relation("DisputesOpened")
  verification               IdentityVerification?
  jobApplications            JobApplication[]       @relation("UserJobApplications")
  completionRequestsAsFixer  JobCompletionRequest[]
  reviewsGiven               JobReview[]            @relation("ReviewsGiven")
  reviewsReceived            JobReview[]            @relation("ReviewsReceived")
  jobsPosted                 Job[]                  @relation("UserJobsPosted")
  jobsAssigned               Job[]                  @relation("UserJobsAssigned")
  notifications              Notification[]
  roles                      UserRole[]
  wallets                    Wallet[]
  withdrawals                WithdrawalRequest[]

  @@map("users")
}

model Role {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model IdentityVerification {
  id                String             @id @default(uuid())
  userId            String             @unique
  ninHash           String             @unique
  bvnHash           String             @unique
  faceHash          String             @unique
  ninImagePath      String
  selfieImagePath   String
  utilityBillPath   String
  bio               String
  skills            String
  addressHouse      String
  addressStreet     String
  addressArea       String
  nearestBusStop    String
  lga               String
  city              String
  state             String
  instagram         String?
  tiktok            String?
  status            VerificationStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reviewReason      String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
}

model Wallet {
  id              String        @id @default(uuid())
  userId          String
  balanceMilliFec Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  role            WalletRole    @default(CLIENT)
  entries         LedgerEntry[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("wallets")
}

model LedgerEntry {
  id             String               @id @default(uuid())
  walletId       String
  type           LedgerEntryType
  direction      LedgerEntryDirection
  amountMilliFec Int
  idempotencyKey String               @unique
  reference      String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  wallet         Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("ledger_entries")
}

model BankDetails {
  id            String   @id @default(uuid())
  userId        String   @unique
  bankName      String
  accountName   String
  accountNumber String
  bvnEncrypted  String
  bvnIv         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bankCode      String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_details")
}

model WithdrawalRequest {
  id                String                 @id @default(uuid())
  userId            String
  amountMilliFec    Int
  status            WithdrawalStatus       @default(PENDING)
  transferReference String?                @unique
  transferCode      String?
  transferStatus    String?
  payoutMode        String?
  earnings          FixerEarning[]
  allocations       WithdrawalAllocation[]
  failureReason     String?
  reviewedBy        String?
  reviewNote        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  reviewedAt        DateTime?
  paidAt            DateTime?
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("withdrawal_requests")
}

model WithdrawalAllocation {
  id String @id @default(cuid())

  withdrawalId String
  earningId    String

  amountMilliFec Int

  createdAt DateTime @default(now())

  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  earning    FixerEarning      @relation(fields: [earningId], references: [id], onDelete: Cascade)

  @@unique([withdrawalId, earningId])
  @@index([withdrawalId])
  @@index([earningId])
  @@map("withdrawal_allocations")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  reference   String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([reference])
}

model Job {
  id                     String                @id @default(cuid())
  clientId               String
  skillCategory          String
  state                  String
  city                   String
  lga                    String?
  area                   String?
  priceMilliFec          Int
  status                 JobStatus             @default(OPEN)
  lockedPriceMilliFec    Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  completedApprovedAt    DateTime?
  completedRequestedAt   DateTime?
  fixerId                String?
  postingType            JobPostingType        @default(STANDARD)
  selectedConversationId String?
  earnings               FixerEarning?
  payments               JobPayment[]
  conversations          Conversation[]
  dispute                Dispute?
  applications           JobApplication[]
  completionRequest      JobCompletionRequest?
  images                 JobImage[]
  review                 JobReview?
  client                 User                  @relation("UserJobsPosted", fields: [clientId], references: [id], onDelete: Cascade)
  fixer                  User?                 @relation("UserJobsAssigned", fields: [fixerId], references: [id])
  PlatformRevenue        PlatformRevenue?

  @@index([status])
  @@index([skillCategory])
  @@index([state, city])
  @@index([clientId])
  @@map("jobs")
}

model JobImage {
  id        String   @id @default(cuid())
  jobId     String
  imagePath String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, sortOrder])
  @@map("job_images")
}

model JobApplication {
  id        String               @id @default(cuid())
  jobId     String
  fixerId   String
  note      String?
  status    JobApplicationStatus @default(APPLIED)
  createdAt DateTime             @default(now())
  fixer     User                 @relation("UserJobApplications", fields: [fixerId], references: [id], onDelete: Cascade)
  job       Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, fixerId])
  @@index([jobId])
  @@index([fixerId])
  @@map("job_applications")
}

model Report {
  id          String           @id @default(uuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      String
  description String?
  status      ReportStatus     @default(PENDING)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  fixerId     String?
  jobId       String?
  reporter    User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
}

model Conversation {
  id          String             @id @default(uuid())
  jobId       String
  fixerId     String
  status      ConversationStatus @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  active      Boolean            @default(false)
  agreements  ChatAgreement[]
  messages    ChatMessage[]
  fixer       User               @relation("ConversationFixer", fields: [fixerId], references: [id], onDelete: Cascade)
  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  negotiation Negotiation?

  @@unique([jobId, fixerId])
  @@index([jobId])
  @@index([fixerId])
  @@map("conversations")
}

model ChatAgreement {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  acceptedAt     DateTime     @default(now())
  ip             String?
  userAgent      String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_agreements")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  flags          ModerationFlag[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Negotiation {
  id                    String            @id @default(uuid())
  conversationId        String            @unique
  status                NegotiationStatus @default(OPEN)
  proposedPriceMilliFec Int?
  lockedPriceMilliFec   Int?
  lockedByUserId        String?
  clientAcceptedAt      DateTime?
  fixerAcceptedAt       DateTime?
  agreedAt              DateTime?
  rejectedAt            DateTime?
  rejectedByUserId      String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  conversation          Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("negotiations")
}

model ModerationFlag {
  id                String               @id @default(uuid())
  messageId         String
  type              ModerationFlagType
  matched           String?
  status            ModerationFlagStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewedByAdminId String?
  createdAt         DateTime             @default(now())

  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reviewedByAdmin Admin?      @relation(fields: [reviewedByAdminId], references: [id])

  @@index([messageId])
  @@index([type])
  @@index([status])
  @@map("moderation_flags")
}

model JobCompletionRequest {
  id                 String                  @id @default(cuid())
  jobId              String                  @unique
  fixerId            String
  status             CompletionRequestStatus @default(PENDING)
  requestedAt        DateTime                @default(now())
  reviewedByClientId String?
  reviewedAt         DateTime?
  reviewNote         String?
  fixer              User                    @relation(fields: [fixerId], references: [id], onDelete: Cascade)
  job                Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([fixerId, status])
  @@index([jobId])
  @@map("job_completion_requests")
}

model JobReview {
  id        String   @id @default(cuid())
  jobId     String   @unique
  clientId  String
  fixerId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  client    User     @relation("ReviewsGiven", fields: [clientId], references: [id], onDelete: Cascade)
  fixer     User     @relation("ReviewsReceived", fields: [fixerId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([fixerId, createdAt])
  @@index([clientId, createdAt])
  @@map("job_reviews")
}

model Admin {
  id                  String              @id @default(cuid())
  email               String              @unique
  fullName            String
  passwordHash        String
  role                AdminRole
  totpSecretEncrypted String
  totpSecretIv        String
  is2faEnabled        Boolean             @default(true)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sessionVersion      Int                 @default(1)
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  AdminRefreshToken   AdminRefreshToken[]
  sessions            AdminSession[]
  AdminAuditLog       AdminAuditLog[]
  resolvedDisputes    Dispute[]
  ModerationFlag      ModerationFlag[]

  @@map("admins")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorAdminId String
  action       String
  description  String
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        Admin    @relation(fields: [actorAdminId], references: [id], onDelete: Cascade)

  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

model AdminRefreshToken {
  id           String    @id @default(cuid())
  adminId      String
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?
  lastUsedAt   DateTime  @default(now())
  admin        Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AdminSession {
  id               String   @id @default(cuid())
  adminId          String
  refreshTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  deviceName       String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime
  admin            Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model PlatformWallet {
  id              String                @id @default(cuid())
  balanceMilliFec Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  entries         PlatformLedgerEntry[]

  @@map("platform_wallets")
}

model PlatformLedgerEntry {
  id               String               @id @default(cuid())
  platformWalletId String
  type             String
  direction        LedgerEntryDirection
  amountMilliFec   Int
  idempotencyKey   String               @unique
  reference        String?
  metadata         Json?
  createdAt        DateTime             @default(now())
  platformWallet   PlatformWallet       @relation(fields: [platformWalletId], references: [id], onDelete: Cascade)

  @@index([platformWalletId, createdAt])
  @@map("platform_ledger_entries")
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  type           NotificationType
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  data           Json?
  idempotencyKey String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Dispute {
  id                String                 @id @default(cuid())
  jobId             String                 @unique
  openedByUserId    String
  reason            String
  evidence          Json?
  status            DisputeStatus          @default(OPEN)
  resolutionType    DisputeResolutionType?
  resolvedByAdminId String?
  resolvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  job               Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  openedBy          User                   @relation("DisputesOpened", fields: [openedByUserId], references: [id])
  resolvedByAdmin   Admin?                 @relation(fields: [resolvedByAdminId], references: [id])

  @@index([status])
  @@map("disputes")
}

model Deposit {
  id             String        @id @default(uuid())
  userId         String
  reference      String        @unique
  amountMilliFec Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  status         DepositStatus @default(PENDING)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reference])
}

model JobPayment {
  id                  String           @id @default(cuid())
  jobId               String
  amountMilliFec      Int
  paymentFeeMilliFec  Int
  status              JobPaymentStatus @default(PENDING)
  paidAt              DateTime?
  expiresAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  paymentReference    String           @unique
  type                JobPaymentType
  conversationId      String?
  fixerId             String?
  lockedPriceMilliFec Int?
  job                 Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, type])
  @@index([fixerId])
  @@index([conversationId])
  @@index([jobId, status])
  @@index([status, expiresAt])
}

model FixerEarning {
  id String @id @default(cuid())

  fixerId String
  jobId   String @unique

  amountMilliFec Int

  availableMilliFec Int

  status FixerEarningStatus @default(AVAILABLE)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  fixer User @relation(fields: [fixerId], references: [id], onDelete: Cascade)
  job   Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  allocations         WithdrawalAllocation[]
  WithdrawalRequest   WithdrawalRequest?     @relation(fields: [withdrawalRequestId], references: [id])
  withdrawalRequestId String?

  @@index([fixerId])
  @@index([status])
  @@map("fixer_earnings")
}

model PlatformRevenue {
  id String @id @default(cuid())

  jobId String @unique

  grossMilliFec       Int
  platformFeeMilliFec Int

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("platform_revenue")
}

enum DeletionRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_SUBMITTED
}

enum AvailabilityStatus {
  UNAVAILABLE
  BUSY
  AVAILABLE
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL_REQUEST
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  JOB_PAYMENT
  JOB_PAYOUT
  COMMISSION
  ADJUSTMENT
  FEE
  WITHDRAWAL_REVERSAL
}

enum LedgerEntryDirection {
  CREDIT
  DEBIT
}

enum WalletRole {
  CLIENT
  FIXER
  SYSTEM
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  PROCESSING
  FAILED
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  DRAFT
}

enum JobApplicationStatus {
  APPLIED
  WITHDRAWN
}

enum ReportTargetType {
  JOB
  CHAT_MESSAGE
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum NegotiationStatus {
  OPEN
  LOCKED
  AGREED
  REJECTED
}

enum ModerationFlagType {
  PHONE_NUMBER
  WHATSAPP
  OFF_PLATFORM_PAYMENT
  ADVERTISEMENT
  OTHER
}

enum CompletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPER_ADMIN
  VERIFICATION_OFFICER
  FINANCE_OFFICER
  SUPPORT_OFFICER
  SECURITY_OFFICER
}

enum NotificationType {
  JOB_COMPLETION_REQUESTED
  JOB_COMPLETION_APPROVED
  JOB_COMPLETION_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  JOB_APPLIED
  DEPOSIT_SUCCEEDED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PAID
  SYSTEM_ANNOUNCEMENT
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeResolutionType {
  RELEASE_TO_FIXER
  REFUND_TO_CLIENT
  PARTIAL_SPLIT
}

enum DepositStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum JobPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum JobPostingType {
  STANDARD
  URGENT
}

enum JobPaymentType {
  POSTING
  URGENT
  FINAL
}

enum FixerEarningStatus {
  AVAILABLE
  PARTIALLY_WITHDRAWN
  PAID
  CANCELLED
}

enum ModerationFlagStatus {
  PENDING
  REVIEWED
  DISMISSED
}
